#!/bin/bash

function usage {
		echo "Usage: $0 <subcommand>"
		exit 1
}

if [ $# -lt 1 ]; then
		usage
fi

function build_x86_64 {
  docker run --rm -v "$(pwd)":/home/rust/src messense/rust-musl-cross:x86_64-musl cargo build --release
	docker run --rm -v "$(pwd)":/home/rust/src messense/rust-musl-cross:x86_64-musl musl-strip /home/rust/src/target/x86_64-unknown-linux-musl/release/git-credential-github-keychain
}

function build_arm {
	docker run --rm -v "$(pwd)":/home/rust/src messense/rust-musl-cross:arm-musleabihf cargo build --release
	docker run --rm -v "$(pwd)":/home/rust/src messense/rust-musl-cross:arm-musleabihf musl-strip /home/rust/src/target/arm-unknown-linux-musleabihf/release/git-credential-github-keychain
}

function build_armv7 {
	docker run --rm -v "$(pwd)":/home/rust/src messense/rust-musl-cross:armv7-musleabihf cargo build --release
	docker run --rm -v "$(pwd)":/home/rust/src messense/rust-musl-cross:armv7-musleabihf musl-strip /home/rust/src/target/armv7-unknown-linux-musleabihf/release/git-credential-github-keychain
}

function create_linux_release_artifact {
	[ -d linux-release ] && rm -rf linux-release
	mkdir -p linux-release

	sudo chown -R runner:docker ./target

	if [ "$1" == "x86_64-linux" ]; then
		cp target/x86_64-unknown-linux-musl/release/git-credential-github-keychain linux-release
	elif [ "$1" == "arm-linux" ]; then
		cp target/arm-unknown-linux-musleabihf/release/git-credential-github-keychain linux-release
	elif [ "$1" == "armv7-linux" ]; then
		cp target/armv7-unknown-linux-musleabihf/release/git-credential-github-keychain linux-release
	fi
	pushd linux-release

	zip -9 git-credential-github-keychain.$1.zip git-credential-github-keychain

	popd

	[ -f linux-release/git-credential-github-keychain.$1.zip ] && mv linux-release/git-credential-github-keychain.$1.zip .
	[ -d linux-release ] && rm -rf linux-release
}

function is_macos {
	system=$(uname -s)
	if [ "$system" == "Darwin" ]; then
		return 0
	else
		return 1
	fi
}

function build_macos {
	if is_macos; then
		cargo build --release
	else
		echo "This command must be run on macOS"
		return 1
	fi
}

# Sets NOTARY_AUTH: CI secrets when present, otherwise the local keychain profile.
function notarytool_auth {
	if [ -z "${AC_USERNAME:-}" ]; then
		NOTARY_AUTH=(--keychain-profile "notarytool-password")
	else
		NOTARY_AUTH=(--apple-id "$AC_USERNAME" --team-id "$AC_PROVIDER" --password "$AC_PASSWORD")
	fi
}

# Submit a zip for notarization and fail unless Apple accepts it.
function notarize_zip {
	local zip="$1" result status id
	notarytool_auth

	if ! result=$(xcrun notarytool submit "$zip" "${NOTARY_AUTH[@]}" --wait --output-format json 2>&1); then
		echo "notarytool submit failed:"
		echo "$result"
		return 1
	fi
	echo "$result"

	status=$(echo "$result" | plutil -extract status raw -o - - 2>/dev/null)
	id=$(echo "$result" | plutil -extract id raw -o - - 2>/dev/null)
	if [ "$status" != "Accepted" ]; then
		echo "Notarization was not accepted (status: ${status:-unknown})"
		if [ -n "$id" ]; then
			xcrun notarytool log "$id" "${NOTARY_AUTH[@]}" || true
		fi
		return 1
	fi
	echo "Notarization accepted (submission $id)"
}

# Confirm Gatekeeper sees the binary as notarized. Apple's online record can lag
# briefly behind an accepted submission, so retry for about a minute.
function check_gatekeeper {
	local binary="$1" attempt out
	for attempt in 1 2 3 4 5 6; do
		out=$(spctl --assess --type open --context context:primary-signature -vv "$binary" 2>&1 || true)
		if echo "$out" | grep -q "source=Notarized Developer ID"; then
			echo "$out"
			return 0
		fi
		echo "Gatekeeper check $attempt: $out"
		sleep 10
	done
	echo "Gatekeeper does not report $binary as notarized"
	return 1
}

function create_macos_artifact {
	if ! is_macos; then
		echo "This command must be run on macOS"
		return 1
	fi

	[ -d macos-notarize ] && rm -rf macos-notarize
	mkdir -p macos-notarize
	cp target/release/git-credential-github-keychain macos-notarize || return 1
	pushd macos-notarize

	# Notary code from https://developer.apple.com/documentation/security/customizing-the-notarization-workflow
	codesign --timestamp --options=runtime -s "9878A293D854126F7FA671B065890283793CD152" git-credential-github-keychain || return 1
	zip -9 git-credential-github-keychain.macos.zip git-credential-github-keychain || return 1
	notarize_zip git-credential-github-keychain.macos.zip || return 1
	check_gatekeeper git-credential-github-keychain || return 1

	popd

	mv macos-notarize/git-credential-github-keychain.macos.zip . || return 1
	rm -rf macos-notarize
}

# Notarize the macOS build already attached to a published release (e.g. after a
# notarization outage). The file isn't changed, so its published checksum stays valid.
function notarize_release {
	local tag="$1" dir
	if ! is_macos; then
		echo "This command must be run on macOS"
		return 1
	fi
	if [ -z "$tag" ]; then
		echo "Usage: $0 notarize-release <tag>"
		return 1
	fi

	dir=$(mktemp -d)
	gh release download "$tag" --pattern git-credential-github-keychain.macos.zip --dir "$dir" || return 1
	unzip -q "$dir/git-credential-github-keychain.macos.zip" -d "$dir/bin" || return 1
	notarize_zip "$dir/git-credential-github-keychain.macos.zip" || return 1
	check_gatekeeper "$dir/bin/git-credential-github-keychain" || return 1
	rm -rf "$dir"
}

function local_build {
	build_x86_64
	build_arm
	build_armv7
	build_macos
}

function create_release {
	current_tag=$(git tag --points-at HEAD)
	current_release_tag=$(gh release list --json tagName --limit 1 -q '.[0].tagName')

	if [ "$current_tag" != "$current_release_tag" ]; then
		echo "Creating release $current_tag"
	else
		echo "Release $current_tag already exists"
		return 1
	fi

	if [ -z "$current_tag" ]; then
		echo "No tag found"

		new_tag=$(echo ${current_release_tag} | awk -F. -v OFS=. '{$NF += 1 ; print}')

		if [ -t 0 ]; then
			read -p "Enter new tag, leave empty for $new_tag or n to exit " new_tag
		else
			new_tag="n"
		fi
		if [ "$new_tag" == "n" ]; then
			exit 1
		fi

		git tag $new_tag
	fi

	gh release create $new_tag --notes "Release $new_tag"
}

case $1 in
	"x86_64")
		build_x86_64
		create_linux_release_artifact x86_64-linux
		;;
	"arm")
		build_arm
		create_linux_release_artifact arm-linux
		;;
	"armv7")
		build_armv7
		create_linux_release_artifact armv7-linux
		;;
	"macos")
		build_macos || exit 1
		create_macos_artifact || exit 1
		;;
	"local-release")
		create_release
		;;
	"local-build")
		local_build
		;;
	"notarize-macos")
		create_macos_artifact || exit 1
		;;
	"notarize-release")
		notarize_release "${2:-}" || exit 1
		;;
	*)
		usage
		;;
esac
